	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.josephhewes.CloudNowAppTV</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cloudnow</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
